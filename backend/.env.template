# Agricultural Waste Backend Environment Configuration
# Copy this file to .env and fill in your actual credentials

# =============================================================================
# Google Services Configuration
# =============================================================================

# Google Gemini API Key (required for AI-powered opportunities generation)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration
# Path to your Firebase service account JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase-service-account-key.json

# Alternative: Firebase configuration as JSON string (for Cloud Run)
# FIREBASE_CONFIG={"type":"service_account","project_id":"your-project",...}

# Google Cloud Project ID (for Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# =============================================================================
# Application Configuration
# =============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# API Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated list for frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend-domain.com

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# Database Configuration
# =============================================================================

# ChromaDB Configuration
CHROMA_DB_PATH=chroma_db
CHROMA_COLLECTION_NAME=agri_waste_knowledge

# Firestore Configuration
FIRESTORE_APP_ID=agri_gain_v1

# =============================================================================
# Machine Learning Configuration
# =============================================================================

# Sentence Transformer Model for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1500

# RAG Configuration
RAG_MAX_RESULTS_PER_QUERY=3
RAG_MAX_TOTAL_RESULTS=15
RAG_CONTEXT_MAX_LENGTH=4000

# =============================================================================
# Security Configuration
# =============================================================================

# API Keys and Secrets (for additional security if needed)
API_SECRET_KEY=your_random_secret_key_for_jwt_if_needed

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Development Configuration
# =============================================================================

# Debug Mode (true/false)
DEBUG=true

# Auto-reload for development
RELOAD=true

# Testing Configuration
TEST_MODE=false

# =============================================================================
# Cloud Run Specific Configuration (for production)
# =============================================================================

# Cloud Run Service Configuration
CLOUD_RUN_SERVICE_NAME=agri-gain-backend
CLOUD_RUN_REGION=us-central1
CLOUD_RUN_MEMORY=4Gi
CLOUD_RUN_CPU=2
CLOUD_RUN_MAX_INSTANCES=10
CLOUD_RUN_MIN_INSTANCES=0

# =============================================================================
# Optional Configuration
# =============================================================================

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Analytics/Monitoring (optional)
# GOOGLE_ANALYTICS_ID=your-analytics-id

# Custom Data Sources (if using external APIs)
# EXTERNAL_API_KEY=your_external_api_key
# EXTERNAL_API_BASE_URL=https://api.example.com